{% extends 'base.html.twig' %}

{% block title %}Ajouter un film - CinéTech{% endblock %}

{% block body %}
    <h1 class="text-3xl font-bold mb-6">Ajouter un film</h1>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        {{ form_widget(form) }}
        <button type="submit" class="mt-4 bg-blue-600 text-white font-semibold px-4 py-2 rounded hover:bg-blue-700">
            Enregistrer
        </button>
    {{ form_end(form) }}

    <div class="mt-4">
        <a href="{{ path('app_movie_index') }}" class="text-blue-600 hover:underline">
            ← Retour au catalogue
        </a>
    </div>
{% endblock %}