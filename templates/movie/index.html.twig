{# templates/movie/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Catalogue - CinéTech{% endblock %}

{% block body %}
    <h1 class="text-3xl font-bold mb-6">
        Notre Catalogue ({{ movies | length }} films)
    </h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {% for movie in movies %}
            <div class="bg-white rounded-lg shadow-md p-6 flex flex-col justify-between">
                <div>
                    <div class="flex justify-between items-start mb-2">
                        <h2 class="text-xl font-bold">{{ movie.title | upper }}</h2>
                        
                        {% if movie.pressRating is not null and movie.pressRating >= 4.5 %}
                            <span class="bg-yellow-400 text-gray-900 text-xs font-bold px-2 py-1 rounded">
                                Coup de cœur
                            </span>
                        {% endif %}
                    </div>

                    <p class="text-sm text-gray-500 mb-3">
                        {{ movie.category.name }} • {{ movie.releaseDate | date('Y') }} • Note : {{ movie.pressRating }}/5
                    </p>
                    <p class="text-gray-700 mb-4">
                        {{ (movie.synopsis ?? '') | slice(0, 100) }}...
                    </p>
                </div>

                <a href="{{ path('app_movie_show', {id: movie.id}) }}" 
                   class="inline-block text-center bg-blue-600 text-white font-semibold py-2 px-4 rounded hover:bg-blue-700">
                    Voir les détails
                </a>
            </div>
        {% else %}
            <p>Aucun film disponible pour le moment.</p>
        {% endfor %}
    </div>
{% endblock %}